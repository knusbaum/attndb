# Compiled binary
/attndb

# Native libraries (built/downloaded locally; see README)
/libs/

# ONNX models + tokenizer (exported locally; large, regenerable)
/models/

# Local Qdrant storage
/qdrant_storage/

# Compose state: generated calibration + the default vault mount point. The
# .env.example file IS committed; .env (machine paths) is not.
/attndb_state/
/vault/
/.env

# Generated calibration (produced by `ingest`/`serve`, tied to a specific
# corpus/namespace — may reflect private content; never commit)
/.attndb-*calibration.json

# Local document corpora — may contain sensitive/internal material; never commit
/corpus/
/corpus_milou/

# Machine-local make overrides (POST_ONNX, personal run targets); see
# Makefile.local.example. The .example file IS committed.
/Makefile.local

# Resolved by `pipenv install` per platform, NOT committed. A lock can hold only
# one entry per package, but torch differs by platform on the CPU wheel index
# (Linux 2.11.0+cpu vs macOS 2.11.0), so any single committed lock breaks the
# other OS. The Pipfile pins what matters; let each machine resolve the rest.
/Pipfile.lock

# Agent session scratch (worktrees, eval scripts)
/.claude/
