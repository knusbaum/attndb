# Copy to .env (git-ignored) and edit. docker compose reads .env automatically.
#
#   cp .env.example .env && docker compose up -d

# The document tree attndb indexes and serves. THE setting to change — point it
# at your vault. Bind-mounted read-write: the write_doc/edit_doc/delete_doc MCP
# tools modify it in place.
ATTNDB_DOCS=./vault

# NOTE: there is no models setting. The encoder weights are pulled and converted
# to ONNX during the image build and baked in at /opt/attndb/models, so nothing
# needs distributing or exporting on the host. To reuse host-exported weights
# instead, uncomment the models bind mount in docker-compose.yml.

# Generated calibration, persisted so a restart doesn't recompute it.
ATTNDB_STATE=./attndb_state

# Where Qdrant keeps its data.
QDRANT_STORAGE=./qdrant_storage

# Host port for the MCP endpoint (http://localhost:$ATTNDB_PORT).
ATTNDB_PORT=8765

# Collection namespace: isolates this index from others in the same Qdrant.
ATTNDB_NS=vault

# Change detection. A Linux container has no FSEvents, so the portable poller
# runs every ATTNDB_POLL; ATTNDB_RESYNC is the full-diff backstop that catches
# bulk/directory operations the granular watcher misses.
ATTNDB_POLL=30s
ATTNDB_RESYNC=5m

# Default relevance gate for search_vault (0 = no gate). Raise it to make the
# server report "no confident match" instead of returning weak hits.
ATTNDB_MIN=0
